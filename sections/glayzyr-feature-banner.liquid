{{ 'glayzyr-sections.css' | asset_url | stylesheet_tag }}
<script src="{{ 'glayzyr-sections.js' | asset_url }}" defer></script>

{%- liquid
  assign s = section.settings
  assign section_id = section.id
  assign banner_classes = ''
  if s.content_alignment == 'center'
    assign banner_classes = 'glayzyr-banner--center'
  endif
-%}

<section
  class="glayzyr-section glayzyr-feature-banner"
  data-glayzyr-section="feature-banner"
  data-section-id="{{ section_id }}"
  style="
    --glayzyr-bg: {{ s.background_color }};
    --glayzyr-text: {{ s.text_color }};
    --glayzyr-accent: {{ s.accent_color }};
    --glayzyr-radius: {{ s.corner_radius }}px;
    --glayzyr-pad-top: {{ s.padding_top }}px;
    --glayzyr-pad-bottom: {{ s.padding_bottom }}px;
    --glayzyr-pad-top-mobile: {{ s.padding_top_mobile }}px;
    --glayzyr-pad-bottom-mobile: {{ s.padding_bottom_mobile }}px;
    --glayzyr-banner-focal: {{ s.focal_point }};
  "
>
  <div class="{% if s.full_width == false %}glayzyr-section__inner{% endif %}">
    {% render 'glayzyr-banner',
      image: s.image,
      mobile_image: s.mobile_image,
      eyebrow: s.eyebrow,
      heading: s.heading,
      description: s.description,
      cta: s.button_label,
      link: s.button_link,
      overlay: s.overlay_opacity,
      text_color: s.banner_text_color,
      button_background: s.button_background,
      button_text: s.button_text_color,
      classes: banner_classes
    %}
  </div>
</section>

<style>
  #shopify-section-{{ section_id }} .glayzyr-section {
    padding-block: var(--glayzyr-pad-top-mobile) var(--glayzyr-pad-bottom-mobile);
  }

  #shopify-section-{{ section_id }} .glayzyr-banner {
    --glayzyr-banner-height: clamp(340px, 68vw, 460px);
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section_id }} .glayzyr-section {
      padding-block: var(--glayzyr-pad-top) var(--glayzyr-pad-bottom);
    }

    #shopify-section-{{ section_id }} .glayzyr-banner {
      --glayzyr-banner-height: clamp(420px, 60vh, 720px);
    }
  }
</style>

{% schema %}
{
  "name": "GLAYZYR feature banner",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "SEE DIFFERENT" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Experience eyewear designed for what's next." },
    {
      "type": "text",
      "id": "description",
      "label": "Description",
      "default": "Placeholder promotional copy for the future GLAYZYR collection."
    },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Discover More →" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "header", "content": "Media" },
    { "type": "image_picker", "id": "image", "label": "Desktop image" },
    { "type": "image_picker", "id": "mobile_image", "label": "Mobile image" },
    {
      "type": "select",
      "id": "focal_point",
      "label": "Image focal point",
      "options": [
        { "value": "center", "label": "Center" },
        { "value": "top", "label": "Top" },
        { "value": "bottom", "label": "Bottom" },
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    { "type": "range", "id": "overlay_opacity", "label": "Overlay", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 45 },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Section background", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Section text", "default": "#0a0a0a" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#ff4d00" },
    { "type": "color", "id": "banner_text_color", "label": "Banner text", "default": "#ffffff" },
    { "type": "color", "id": "button_background", "label": "Button background", "default": "#ffffff" },
    { "type": "color", "id": "button_text_color", "label": "Button text", "default": "#0a0a0a" },
    { "type": "header", "content": "Layout" },
    { "type": "checkbox", "id": "full_width", "label": "Full width", "default": false },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Content alignment",
      "options": [
        { "value": "start", "label": "Bottom left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "start"
    },
    { "type": "range", "id": "corner_radius", "label": "Corner radius", "min": 0, "max": 48, "step": 2, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding_top", "label": "Top spacing", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom spacing", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_top_mobile", "label": "Top spacing (mobile)", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Bottom spacing (mobile)", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 48 }
  ],
  "presets": [{ "name": "GLAYZYR feature banner" }]
}
{% endschema %}
