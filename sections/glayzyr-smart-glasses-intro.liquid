{{ 'glayzyr-sections.css' | asset_url | stylesheet_tag }}
<script src="{{ 'glayzyr-sections.js' | asset_url }}" defer></script>
<script src="{{ 'glayzyr-smart-glasses-intro.js' | asset_url }}" defer></script>

{%- liquid
  assign s = section.settings
  assign section_id = section.id
  assign image_alt = s.heading | default: 'Smart glasses' | escape
  if s.image.alt != blank
    assign image_alt = s.image.alt | escape
  endif
-%}

<section
  class="glayzyr-section glayzyr-intro"
  data-glayzyr-section="smart-glasses-intro"
  data-section-id="{{ section_id }}"
  data-animate="{{ s.enable_animation }}"
  data-intensity="{{ s.animation_intensity }}"
  style="
    --glayzyr-bg: {{ s.background_color }};
    --glayzyr-text: {{ s.text_color }};
    --glayzyr-accent: {{ s.accent_color }};
    --glayzyr-button-bg: {{ s.button_background }};
    --glayzyr-button-text: {{ s.button_text_color }};
    --glayzyr-radius: {{ s.corner_radius }}px;
    --glayzyr-pad-top: {{ s.padding_top }}px;
    --glayzyr-pad-bottom: {{ s.padding_bottom }}px;
    --glayzyr-pad-top-mobile: {{ s.padding_top_mobile }}px;
    --glayzyr-pad-bottom-mobile: {{ s.padding_bottom_mobile }}px;
  "
>
  <div class="glayzyr-section__inner glayzyr-intro__grid">
    <div class="glayzyr-intro__content">
      {%- if s.eyebrow != blank -%}
        <p class="glayzyr-eyebrow" data-glayzyr-reveal>{{ s.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if s.heading != blank -%}
        <h2 class="glayzyr-heading" data-glayzyr-reveal style="--glayzyr-reveal-delay: 80ms;">
          {{ s.heading | escape }}
        </h2>
      {%- endif -%}
      {%- if s.description != blank -%}
        <div class="glayzyr-body" data-glayzyr-reveal style="--glayzyr-reveal-delay: 160ms;">
          {{ s.description }}
        </div>
      {%- endif -%}
      {%- if s.button_label != blank -%}
        <a
          class="glayzyr-cta"
          href="{{ s.button_link | default: '#' }}"
          data-glayzyr-reveal
          style="--glayzyr-reveal-delay: 240ms;"
        >
          {{ s.button_label | escape }}
        </a>
      {%- endif -%}
    </div>

    <div class="glayzyr-intro__media" data-glayzyr-media>
      {%- if s.image != blank -%}
        {{
          s.image
          | image_url: width: 1600
          | image_tag: loading: 'lazy', widths: '400,600,800,1200,1600', sizes: '(max-width: 989px) 88vw, 46vw', alt: image_alt, class: 'glayzyr-intro__image'
        }}
      {%- else -%}
        <img
          class="glayzyr-intro__image"
          src="{{ 'glazyr-glass.png' | asset_url }}"
          alt="{{ s.heading | escape }}"
          width="1600"
          height="900"
          loading="lazy"
        >
      {%- endif -%}
    </div>
  </div>
</section>

<style>
  #shopify-section-{{ section_id }} .glayzyr-intro__grid {
    display: grid;
    grid-template-columns: 1fr;
    align-items: center;
    gap: var(--glayzyr-gap);
  }

  #shopify-section-{{ section_id }} .glayzyr-intro__media {
    position: relative;
    border-radius: var(--glayzyr-radius);
    overflow: hidden;
    will-change: transform;
  }

  #shopify-section-{{ section_id }} .glayzyr-intro__image {
    display: block;
    width: 100%;
    height: auto;
    object-fit: contain;
  }

  #shopify-section-{{ section_id }} .glayzyr-section {
    padding-block: var(--glayzyr-pad-top-mobile) var(--glayzyr-pad-bottom-mobile);
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section_id }} .glayzyr-section {
      padding-block: var(--glayzyr-pad-top) var(--glayzyr-pad-bottom);
    }
  }

  @media screen and (min-width: 990px) {
    #shopify-section-{{ section_id }} .glayzyr-intro__grid {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      gap: clamp(32px, 5vw, 90px);
    }
  }
</style>

{% schema %}
{
  "name": "GLAYZYR intro",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "THE NEXT VIEW" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Meet the Future of Eyewear" },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Smart eyewear designed to blend intelligent technology with everyday style.</p>"
    },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Discover Smart Glasses →" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Falls back to the theme's product render." },
    { "type": "header", "content": "Motion" },
    { "type": "checkbox", "id": "enable_animation", "label": "Enable scroll animation", "default": true },
    {
      "type": "range",
      "id": "animation_intensity",
      "label": "Animation intensity",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 45
    },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#0a0a0a" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#ff4d00" },
    { "type": "color", "id": "button_background", "label": "Button background", "default": "#0a0a0a" },
    { "type": "color", "id": "button_text_color", "label": "Button text", "default": "#ffffff" },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "corner_radius", "label": "Corner radius", "min": 0, "max": 48, "step": 2, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding_top", "label": "Top spacing", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom spacing", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_top_mobile", "label": "Top spacing (mobile)", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Bottom spacing (mobile)", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 56 }
  ],
  "presets": [{ "name": "GLAYZYR intro" }]
}
{% endschema %}
