{{ 'glayzyr-sections.css' | asset_url | stylesheet_tag }}
<script src="{{ 'glayzyr-sections.js' | asset_url }}" defer></script>

{%- liquid
  assign s = section.settings
  assign section_id = section.id
-%}

<section
  class="glayzyr-section glayzyr-promo"
  data-glayzyr-section="promo-banners"
  data-section-id="{{ section_id }}"
  style="
    --glayzyr-bg: {{ s.background_color }};
    --glayzyr-text: {{ s.text_color }};
    --glayzyr-accent: {{ s.accent_color }};
    --glayzyr-radius: {{ s.corner_radius }}px;
    --glayzyr-pad-top: {{ s.padding_top }}px;
    --glayzyr-pad-bottom: {{ s.padding_bottom }}px;
    --glayzyr-pad-top-mobile: {{ s.padding_top_mobile }}px;
    --glayzyr-pad-bottom-mobile: {{ s.padding_bottom_mobile }}px;
  "
>
  <div class="{% if s.full_width == false %}glayzyr-section__inner{% endif %}">
    <div class="glayzyr-promo__stack">
      {%- for block in section.blocks -%}
        {%- liquid
          assign b = block.settings
          assign block_classes = 'glayzyr-promo__item'
          if forloop.first
            assign block_classes = block_classes | append: ' glayzyr-promo__item--wide'
          endif
        -%}
        <div
          class="{{ block_classes }}"
          style="--glayzyr-banner-focal: {{ b.focal_point }};"
          {{ block.shopify_attributes }}
        >
          {% render 'glayzyr-banner',
            image: b.image,
            mobile_image: b.mobile_image,
            eyebrow: b.eyebrow,
            heading: b.heading,
            description: b.description,
            cta: b.button_label,
            link: b.button_link,
            overlay: b.overlay_opacity,
            text_color: b.text_color,
            button_background: b.button_background,
            button_text: b.button_text_color,
            heading_tag: 'h3'
          %}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  #shopify-section-{{ section_id }} .glayzyr-section {
    padding-block: var(--glayzyr-pad-top-mobile) var(--glayzyr-pad-bottom-mobile);
  }

  /* Mobile: every banner stacks with breathing room. */
  #shopify-section-{{ section_id }} .glayzyr-promo__stack {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(12px, 3vw, 20px);
  }

  #shopify-section-{{ section_id }} .glayzyr-banner {
    --glayzyr-banner-height: clamp(300px, 62vw, 420px);
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section_id }} .glayzyr-section {
      padding-block: var(--glayzyr-pad-top) var(--glayzyr-pad-bottom);
    }

    /* Desktop: full-width lead banner, then equal-height columns that touch. */
    #shopify-section-{{ section_id }} .glayzyr-promo__stack {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0;
      border-radius: var(--glayzyr-radius);
      overflow: hidden;
    }

    #shopify-section-{{ section_id }} .glayzyr-promo__item--wide {
      grid-column: 1 / -1;
    }

    #shopify-section-{{ section_id }} .glayzyr-promo__item .glayzyr-banner {
      --glayzyr-radius: 0;
      --glayzyr-banner-height: clamp(320px, 40vh, 460px);
      height: 100%;
    }

    #shopify-section-{{ section_id }} .glayzyr-promo__item--wide .glayzyr-banner {
      --glayzyr-banner-height: clamp(420px, 60vh, 700px);
    }
  }
</style>

{% schema %}
{
  "name": "GLAYZYR promo banners",
  "tag": "div",
  "max_blocks": 3,
  "settings": [
    { "type": "color", "id": "background_color", "label": "Section background", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Section text", "default": "#0a0a0a" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#ff4d00" },
    { "type": "checkbox", "id": "full_width", "label": "Full width", "default": false },
    { "type": "range", "id": "corner_radius", "label": "Corner radius", "min": 0, "max": 48, "step": 2, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding_top", "label": "Top spacing", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom spacing", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_top_mobile", "label": "Top spacing (mobile)", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Bottom spacing (mobile)", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 48 }
  ],
  "blocks": [
    {
      "type": "banner",
      "name": "Banner",
      "settings": [
        { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Promotional heading" },
        { "type": "text", "id": "description", "label": "Description" },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop now →" },
        { "type": "url", "id": "button_link", "label": "Link" },
        { "type": "image_picker", "id": "image", "label": "Desktop image" },
        { "type": "image_picker", "id": "mobile_image", "label": "Mobile image" },
        {
          "type": "select",
          "id": "focal_point",
          "label": "Image focal point",
          "options": [
            { "value": "center", "label": "Center" },
            { "value": "top", "label": "Top" },
            { "value": "bottom", "label": "Bottom" },
            { "value": "left", "label": "Left" },
            { "value": "right", "label": "Right" }
          ],
          "default": "center"
        },
        { "type": "range", "id": "overlay_opacity", "label": "Overlay", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 45 },
        { "type": "color", "id": "text_color", "label": "Text", "default": "#ffffff" },
        { "type": "color", "id": "button_background", "label": "Button background", "default": "#ffffff" },
        { "type": "color", "id": "button_text_color", "label": "Button text", "default": "#0a0a0a" }
      ]
    }
  ],
  "presets": [
    {
      "name": "GLAYZYR promo banners",
      "blocks": [
        {
          "type": "banner",
          "settings": {
            "eyebrow": "THE FLAGSHIP",
            "heading": "Vision, redefined for every hour of the day.",
            "description": "Placeholder promotional copy for the flagship GLAYZYR release.",
            "button_label": "Explore the flagship →"
          }
        },
        {
          "type": "banner",
          "settings": {
            "eyebrow": "NEW ARRIVALS",
            "heading": "Frames just landed",
            "button_label": "Shop new →"
          }
        },
        {
          "type": "banner",
          "settings": {
            "eyebrow": "ACCESSORIES",
            "heading": "Built to travel",
            "button_label": "Shop accessories →"
          }
        }
      ]
    }
  ]
}
{% endschema %}
